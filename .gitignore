# Datasets and archives (>100MB)
*.zip
*.tar
*.gz

# Raw and stabilized ride videos (>50-100MB)
*.mp4
*.webm
*.avi
*.mov

# Python cache & build
__pycache__/
*.py[cod]
*$py.class
*.pkl.bak

# Kaggle downloaded run caches and training weight artifacts
kaggle_train_job/output/
kaggle_train_job/output_v2/
kaggle_train_job/output_v3/

# Microsoft Office temporary lock files
~$*.docx
~$*.pptx
~$*.xlsx

# OS files
Thumbs.db
.DS_Store
